# Copy to .env.local. The README explains what each group is for.

# Required
DATABASE_URL=postgres://user:password@localhost:5432/wedding
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Site URL. On Vercel this falls back to the project's production domain.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Photo gallery: S3 bucket and role, created by the CDK stack
AWS_REGION=
AWS_ROLE_ARN=
S3_BUCKET=
# Use the same bucket here. The browser builds image URLs from this value and
# the image route only reads from this bucket.
NEXT_PUBLIC_S3_BUCKET=
# Set automatically on Vercel. Run `vercel env pull` to get one locally.
VERCEL_OIDC_TOKEN=

# Media uploads: Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Registry and Honeymoon Fund. Only the exact value "true" opens them.
REGISTRY_OPEN="false"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Analytics: Mixpanel
MIXPANEL_PROJECT_ID=
MIXPANEL_PROJECT_TOKEN=

# Error reporting: Sentry. Leave the DSN empty to turn reporting off.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
